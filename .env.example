# ==============================================================================
# Aurelia Estates — Real Estate Property Management System
# Environment Configuration Example
# Copy this file to .env and populate with your credentials.
# NEVER commit .env or real secrets to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ==============================================================================
# SMTP Email Service (Nodemailer) — Required for Inquiry Notifications
# All property inquiries are emailed to INQUIRY_RECIPIENT_EMAIL.
#
# For Gmail SMTP:
#   1. Enable 2-Step Verification on your Google Account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
#   4. Set SMTP_USER to your Gmail address and SMTP_PASS to the 16-char App Password.
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-sender-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="Aurelia Estates <your-sender-email@gmail.com>"
INQUIRY_RECIPIENT_EMAIL="anujmlahoti24@gmail.com"

# WhatsApp Business Contact (Digits only with country code, e.g., 919820012345)
VITE_WHATSAPP_NUMBER="919820012345"

# AI Studio Runtime Key (Optional / Managed by Environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
