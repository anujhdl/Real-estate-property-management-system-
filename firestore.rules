rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Reusable Security Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped verified administrators (no DB read required; safe for list rules)
    function isBootstrappedAdmin() {
      return isVerified() && (
        request.auth.token.email == 'anujmlahoti521@gmail.com' ||
        request.auth.token.email == 'anujmlahoti24@gmail.com'
      );
    }

    // Full admin check for single-document operations (get/create/update/delete)
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // Entity Validation Blueprints (Pillar 2 & Pillar 5)
    // =========================================================================
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStringList(val, minLen, maxLen) {
      return val is list &&
        val.size() >= minLen &&
        val.size() <= maxLen &&
        (val.size() == 0 || (val[0] is string && val[0].size() <= 500));
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'name', 'email', 'authProviderId', 'role', 'favorites', 'createdAt']) &&
        data.keys().hasOnly(['id', 'name', 'email', 'authProviderId', 'role', 'phone', 'favorites', 'createdAt']) &&
        data.id == userId &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.email, 3, 160) &&
        isValidString(data.authProviderId, 1, 64) &&
        data.role in ['user', 'admin'] &&
        isValidOptionalString(data, 'phone', 30) &&
        isValidStringList(data.favorites, 0, 50) &&
        data.createdAt is timestamp;
    }

    function isValidProperty(data, propertyId) {
      return data.keys().hasAll([
          'id', 'propertyCode', 'title', 'description', 'price',
          'location', 'city', 'propertyType', 'listingType',
          'bedrooms', 'bathrooms', 'area', 'images', 'amenities',
          'status', 'featured', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'propertyCode', 'title', 'description', 'price',
          'location', 'city', 'propertyType', 'listingType',
          'bedrooms', 'bathrooms', 'area', 'images', 'amenities',
          'status', 'featured', 'latitude', 'longitude', 'createdAt', 'updatedAt'
        ]) &&
        data.id == propertyId &&
        isValidId(data.id) &&
        isValidString(data.propertyCode, 2, 32) &&
        isValidString(data.title, 3, 180) &&
        isValidString(data.description, 10, 4000) &&
        data.price is number && data.price >= 0 && data.price <= 100000000000 &&
        isValidString(data.location, 2, 160) &&
        isValidString(data.city, 2, 80) &&
        data.propertyType in [
          'Luxury Villas',
          'Modern Apartments',
          'Independent Houses',
          'Residential Plots',
          'Commercial Properties',
          'Premium Penthouses',
          'Family Homes'
        ] &&
        data.listingType in ['Buy', 'Rent'] &&
        data.bedrooms is number && data.bedrooms >= 0 && data.bedrooms <= 30 &&
        data.bathrooms is number && data.bathrooms >= 0 && data.bathrooms <= 30 &&
        data.area is number && data.area >= 100 && data.area <= 10000000 &&
        isValidStringList(data.images, 1, 10) &&
        isValidStringList(data.amenities, 0, 25) &&
        data.status in ['Available', 'Reserved', 'Sold', 'Rented'] &&
        data.featured is bool &&
        (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90)) &&
        (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInquiry(data, inquiryId) {
      return data.keys().hasAll([
          'id', 'fullName', 'email', 'phone', 'propertyId', 'propertyTitle',
          'inquiryType', 'preferredContact', 'message', 'status',
          'emailDeliveryStatus', 'userId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'fullName', 'email', 'phone', 'propertyId', 'propertyTitle',
          'inquiryType', 'preferredContact', 'message', 'status',
          'emailDeliveryStatus', 'emailError', 'userId', 'createdAt'
        ]) &&
        data.id == inquiryId &&
        isValidId(data.id) &&
        isValidString(data.fullName, 2, 120) &&
        isValidString(data.email, 5, 160) &&
        isValidString(data.phone, 7, 30) &&
        isValidString(data.propertyId, 1, 128) &&
        isValidString(data.propertyTitle, 2, 200) &&
        data.inquiryType in ['Buying', 'Renting', 'Site Visit', 'General Inquiry'] &&
        data.preferredContact in ['Phone', 'Email', 'WhatsApp'] &&
        isValidString(data.message, 5, 2500) &&
        data.status in ['New', 'Contacted', 'In Progress', 'Closed'] &&
        data.emailDeliveryStatus in ['sent', 'failed', 'pending'] &&
        isValidOptionalString(data, 'emailError', 500) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'grantedAt']) &&
        data.keys().hasOnly(['email', 'grantedAt']) &&
        isValidString(data.email, 5, 160) &&
        data.grantedAt is timestamp;
    }

    // =========================================================================
    // Collection: /users/{userId} (PII Isolated)
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (
        (isVerified() && request.auth.uid == userId) ||
        isAdmin()
      );

      allow list: if isBootstrappedAdmin();

      allow create: if isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time &&
        (
          incoming().role == 'user' ||
          (incoming().role == 'admin' && isBootstrappedAdmin())
        );

      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id &&
        incoming().authProviderId == existing().authProviderId &&
        (
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'favorites'])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'favorites', 'role'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // =========================================================================
    // Collection: /properties/{propertyId} (Public Catalog, Admin Managed)
    // =========================================================================
    match /properties/{propertyId} {
      allow get: if isValidId(propertyId);
      allow list: if true;

      allow create: if isAdmin() &&
        isValidId(propertyId) &&
        isValidProperty(incoming(), propertyId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(propertyId) &&
        isValidProperty(incoming(), propertyId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'propertyCode', 'title', 'description', 'price', 'location', 'city',
          'propertyType', 'listingType', 'bedrooms', 'bathrooms', 'area',
          'images', 'amenities', 'status', 'featured', 'latitude', 'longitude', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(propertyId);
    }

    // =========================================================================
    // Collection: /inquiries/{inquiryId} (Public Lead Submission, Admin & Owner Scoped Reads)
    // =========================================================================
    match /inquiries/{inquiryId} {
      allow get: if isVerified() && isValidId(inquiryId) && (
        isAdmin() ||
        existing().userId == request.auth.uid
      );

      allow list: if isVerified() && (
        isBootstrappedAdmin() ||
        resource.data.userId == request.auth.uid
      );

      allow create: if isValidId(inquiryId) &&
        isValidInquiry(incoming(), inquiryId) &&
        incoming().status == 'New' &&
        incoming().createdAt == request.time &&
        (
          (request.auth == null && incoming().userId == '') ||
          (request.auth != null && (incoming().userId == request.auth.uid || incoming().userId == ''))
        );

      allow update: if isAdmin() &&
        isValidId(inquiryId) &&
        isValidInquiry(incoming(), inquiryId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'emailDeliveryStatus', 'emailError']);

      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    // =========================================================================
    // Collection: /admins/{adminId} (Authoritative Admin Roster)
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && (
        request.auth.uid == adminId || isAdmin()
      );
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminRecord(incoming()) && incoming().grantedAt == request.time;
      allow update: if isAdmin() && isValidId(adminId) && isValidAdminRecord(incoming()) && incoming().grantedAt == existing().grantedAt && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if isAdmin() && isValidId(adminId);
    }
  }
}
